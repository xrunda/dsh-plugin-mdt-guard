{
  "name": "@local/dsh-mdt-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./config": "./config.js",
    "./rules": "./rules.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "cordis.patch.yml",
    "index.js",
    "config.js",
    "rules.js",
    "rule-defaults.js",
    "session-state.js",
    "classifier-context.js",
    "classifier-client.js",
    "gate.js",
    "audit-log.js",
    "pre-step.js",
    "tool-policy.js",
    "client.js",
    "types/contracts.d.ts",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "sandbox-guard.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  }
}
